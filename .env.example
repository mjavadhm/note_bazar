# توکن بات — از BotFather بگیر
BOT_TOKEN=

# رمز مشترک بین بات و API — یه رشته تصادفی بلند بذار
API_SECRET=change-me-to-a-long-random-string

# آیدی عددی تلگرام ادمین‌ها (با کاما جدا کن)
ADMIN_TELEGRAM_IDS=

# درصد کمیسیون پلتفرم از هر فروش
COMMISSION_PERCENT=20

# آدرس عمومی سایت/مینی‌اپ (HTTPS) — برای دکمه «مطالعه آنلاین» داخل بات
# مثلاً: https://notes.example.com — خالی بمونه تا دکمه نشون داده نشه
MINIAPP_URL=

# زیرساخت (همین مقادیر با docker-compose هماهنگه — دست نزن مگر لازم باشه)
DATABASE_URL=postgresql+psycopg://notebazar:notebazar@db:5432/notebazar
REDIS_URL=redis://redis:6379/0
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio123
S3_BUCKET=notebazar
API_BASE_URL=http://api:8000
TELEGRAM_FILE_API=https://api.telegram.org
